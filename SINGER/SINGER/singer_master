def open_vcf(vcf_prefix):
    if os.path.exists(vcf_prefix + ".vcf.gz"):
        return gzip.open(vcf_prefix + ".vcf.gz", 'rt')
    return open(vcf_prefix + ".vcf")

def calculate_diversity(vcf_prefix, start, end):
    total_diversity = 0.0
    segment_length = end - start
    num_variants = 0

    # Open the VCF file and read it line by line
    with open_vcf(vcf_prefix) as vcf:
        for line in vcf:
            # Skip header lines
            if line.startswith("#"):
                continue

            # Split the VCF record into fields
            fields = line.strip().split('\t')
            pos = int(fields[1])  # Get the position of the variant
            
            # Check if the variant is within the target region
            if pos < start:
                continue
            if pos > end:
                break
            
            # Extract genotype information for each sample (after the 9th column)
            alleles = [fields[3]] + fields[4].split(",")  # REF and ALT alleles
            allele_counts = [0] * len(alleles)
            num_samples = 0

            # Iterate over the genotype columns to count allele occurrences
            for sample_field in fields[9:]:
                gt = sample_field.split(':')[0]  # Extract the genotype (e.g., "0/1")
                if '.' in gt:  # Missing data
                    continue
                
                # Genotype fields are usually formatted like "0/1", "1/1", etc.
                gt_alleles = gt.replace('|', '/').split('/')  # Handle phased/unphased
                num_samples += 1
                for allele in gt_alleles:
                    allele_counts[int(allele)] += 1

            # Calculate allele frequencies
            if num_samples == 0:
                continue  # Skip if there are no valid samples
            allele_freqs = [ac / (2 * num_samples) for ac in allele_counts]
            
            # Calculate diversity for the current variant
            variant_diversity = sum(f * (1 - f) for f in allele_freqs if f > 0 and f < 1)
            
            # Add to total diversity
            total_diversity += variant_diversity
            num_variants += 1

    nucleotide_diversity = total_diversity / segment_length
    return nucleotide_diversity

def vcf_sample_names(vcf_prefix):
    with open_vcf(vcf_prefix) as vcf:
        for line in vcf:
            if line.startswith("#CHROM"):
                return line.strip().split('\t')[9:]
    return []

def read_tip_ages(tip_ages_file, vcf_prefix, ploidy):
    names = vcf_sample_names(vcf_prefix)
    n = ploidy*len(names)
    rows = []
    ncol = None
    with open(tip_ages_file) as f:
        for lineno, line in enumerate(f, 1):
            parts = line.split()
            if not parts or parts[0].startswith('#'):
                continue
            if ncol is None:
                ncol = len(parts)
            if len(parts) != ncol or ncol > 2:
                raise ValueError(f"tip_ages line {lineno}: expected 1 column (ages in VCF sample order) or 2 columns (name age)")
            rows.append((parts[0] if ncol == 2 else None, float(parts[-1])))
    if len(rows) != len(names):
        raise ValueError(f"tip_ages has {len(rows)} rows for {len(names)} samples in the VCF")
    if ncol == 1:
        return [rows[i//ploidy][1] for i in range(n)]
    by_name = {}
    for name, age in rows:
        if name in by_name:
            raise ValueError(f"tip_ages: duplicate name {name!r}")
        by_name[name] = age
    ages = []
    for i in range(n):
        if names[i//ploidy] not in by_name:
            raise ValueError(f"tip_ages has no row for {names[i//ploidy]!r}")
        ages.append(by_name[names[i//ploidy]])
    return ages

def compute_Ne(vcf_prefix, start, end, m, ages=None, g=None):
    diversity = calculate_diversity(vcf_prefix, start, end)
    mean_abs_diff = 0.0
    if ages:
        gens = [a/g for a in ages]
        n = len(gens)
        pairs = [abs(gens[i] - gens[j]) for i in range(n) for j in range(i + 1, n)]
        mean_abs_diff = sum(pairs)/len(pairs)
    Ne = diversity/4/m - mean_abs_diff/4
    if Ne <= 0:
        raise ValueError(f"Estimated Ne is non-positive ({Ne:.1f}). Check that tip ages and mutation rate are in consistent units.")
    print(f"Estimated Ne: {Ne:.1f}")
    return Ne

def tip_flags(tip_ages, g):
    if tip_ages is None:
        return ""
    return f" -tip_ages {tip_ages} -g {g}"

def singer_path():
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "singer")

def run_with_auto_debug(first_cmd, debug_cmd, seed, max_attempts, output_prefix):
    random.seed(seed)
    random_seeds = [random.randint(0, 2**30 - 1) for _ in range(max_attempts)]
    cmd = first_cmd + f" -seed {seed}"
    print(cmd)
    process = subprocess.run(cmd.split(), check=False)
    attempts = 0
    while process.returncode != 0:
        with open(output_prefix + ".attempts", "a") as f:
            f.write(f"{cmd}\treturn code {process.returncode}\n")
        if attempts == max_attempts:
            print(f"Auto-debug failed after {attempts} attempts (commands in {output_prefix}.attempts). Contact the author for help: yun_deng@berkeley.edu")
            sys.exit(1)
        print(f"Auto-debug iteration: {attempts}")
        cmd = debug_cmd + f" -seed {random_seeds[attempts]}"
        print(cmd)
        process = subprocess.run(cmd.split(), check=False)
        attempts += 1

def is_number(value):
    try:
        float(value)
    except ValueError:
        return False
    return True

def run_singer(Ne, m, r, start, end, vcf_prefix, output_prefix, num_iters, thin, polar, ploidy, seed, tips, max_attempts, resume):
    common = f"{singer_path()} -Ne {Ne} -m {m} -r {r} -input {vcf_prefix} -output {output_prefix} -start {start} -end {end} -polar {polar} -n {num_iters} -thin {thin}"
    first = common + (" -resume" if resume else "") + f" -ploidy {ploidy}" + tips
    run_with_auto_debug(first, common + f" -debug -ploidy {ploidy}" + tips, seed, max_attempts, output_prefix)

      
def main():
    parser = argparse.ArgumentParser(description='Sample and infer ARG from genetic variation data')

    parser.add_argument('-Ne', type=float, default=-1, help='Effective population size.')
    parser.add_argument('-m', type=str, required=True, help='Mutation rate per base per generation: a number, or a rate map file with lines "left right rate".')
    parser.add_argument('-r', type=str, help='Recombination rate per base per generation: a number, or a rate map file. Default: the -m value when -m is a number.')
    parser.add_argument('-vcf', type=str, help='VCF file prefix (without .vcf or .vcf.gz extension).')
    parser.add_argument('-output', type=str, required=True, help='Output file prefix.')
    parser.add_argument('-start', type=float, required=True, help='Start position.')
    parser.add_argument('-end', type=float, required=True, help='End position.')
    parser.add_argument('-n', type=int, default=100, help='Number of MCMC samples. Default: 100.')
    parser.add_argument('-thin', type=int, default=200, help='Number of MCMC iterations between adjacent samples. Default: 200.')
    parser.add_argument('-polar', type=float, default=0.5, help='Site flip probability. Default: 0.5.')
    parser.add_argument('-resume', action='store_true', help='Resume MCMC with this flag.')
    parser.add_argument('-ploidy', type=int, default=2, help="Ploidy of the vcf file (1 or 2). Default: 2.")
    parser.add_argument('-seed', type=int, default=42, help='Random seed for reproducibility. Default: 42.')
    parser.add_argument('-tip_ages', type=str, help='File with the sample ages in years before present, one per haplotype in VCF haplotype order or one per individual. Requires -g.')
    parser.add_argument('-g', type=float, help='Generation time in years, used with -tip_ages.')
    parser.add_argument('-mask', type=str, help='BED file of regions without data; only the remaining bases enter the mutation model.')
    parser.add_argument('-max_attempts', type=int, default=100, help='Maximum number of automatic restarts (-debug) after a failed run; 0 disables them. Each failed command is appended to OUTPUT.attempts. Default: 100.')

    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        sys.exit(1)

    args = parser.parse_args()

    if args.r is None:
        if not is_number(args.m):
            parser.error("You must provide -r when -m is a rate map file")
        args.r = args.m

    if args.tip_ages and not args.g:
        parser.error("You must provide -g with -tip_ages")
    tips = tip_flags(args.tip_ages, args.g)
    if args.mask:
        tips += f" -mask {args.mask}"
    ages = read_tip_ages(args.tip_ages, args.vcf, args.ploidy) if args.tip_ages else None

    m = float(args.m) if is_number(args.m) else compute_average_rate(args.m, args.start, args.end)
    if m == 0:
        parser.error("The mutation rate is set to 0")
    if args.Ne < 0:
        args.Ne = compute_Ne(args.vcf, args.start, args.end, m, ages, args.g)
    run_singer(args.Ne, args.m, args.r, args.start, args.end, args.vcf, args.output, args.n, args.thin, args.polar, args.ploidy, args.seed, tips, args.max_attempts, args.resume)


if __name__ == "__main__":
    main()
