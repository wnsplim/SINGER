def is_alignment(path):
    with open(path, 'rb') as f:
        head = f.read(64).lstrip()
    return len(head) > 0 and (head[:1] == b'>' or head[:1].isdigit() or head[:6].upper() == b'#NEXUS')


def read_alignment(path):
    with open(path) as f:
        text = f.read()
    stripped = text.lstrip()
    names, seqs = [], []
    if stripped.startswith('>'):
        for block in stripped.split('>')[1:]:
            lines = block.split('\n')
            names.append(lines[0].split()[0])
            seqs.append(''.join(l.strip() for l in lines[1:]))
        return names, seqs
    if stripped.upper().startswith('#NEXUS'):
        clean = ''
        depth = 0
        for c in text:
            if c == '[':
                depth += 1
            elif c == ']':
                depth = max(0, depth - 1)
            elif depth == 0:
                clean += c
        low = clean.lower()
        block = clean[low.find('matrix') + 6:]
        block = block[:block.find(';')]
        order, parts = [], {}
        for line in block.split('\n'):
            w = line.split()
            if len(w) < 2:
                continue
            name = w[0]
            if name not in parts:
                order.append(name)
                parts[name] = ''
            parts[name] += ''.join(w[1:])
        return order, [parts[n] for n in order]
    lines = [l for l in stripped.split('\n') if l.strip()]
    ntax, nsite = int(lines[0].split()[0]), int(lines[0].split()[1])
    body = lines[1:]
    if len(body) == ntax:
        for l in body:
            w = l.split()
            names.append(w[0])
            seqs.append(''.join(w[1:]))
        return names, seqs
    seqs = [''] * ntax
    for b in range(len(body)//ntax):
        for i in range(ntax):
            w = body[b*ntax + i].split()
            if b == 0:
                names.append(w[0])
                seqs[i] += ''.join(w[1:])
            else:
                seqs[i] += ''.join(w)
    return names, seqs


def calculate_diversity_alignment(seqs, start, end, mask_n=None, mask_p=None, chrom_n=None, chrom_p=None):
    start, end = int(start), int(end)
    masked = []
    if mask_n or mask_p:
        if (mask_n and not chrom_n) or (mask_p and not chrom_p):
            sys.exit("Error: a mask with an alignment needs -chrom_n or -chrom_p.")
        masked = [(lo - 1, hi - 1) for lo, hi in read_masks(mask_n, mask_p, chrom_n, chrom_p, start, end)]
    masked_columns = sum(hi - lo + 1 for lo, hi in masked)
    total = 0.0
    index = {'A': 0, 'C': 1, 'G': 2, 'T': 3, 'U': 3}
    columns = np.array([[index.get(c.upper(), -1) for c in s[start:end]] for s in seqs], dtype=np.int8)
    for lo, hi in masked:
        columns[:, lo - start:hi - start + 1] = -1
    k = np.sum(columns >= 0, axis=0).astype(float)
    het = np.zeros(columns.shape[1])
    for b in range(4):
        f = np.sum(columns == b, axis=0)/np.maximum(k, 1)
        het += f*(1 - f)
    ok = k >= 2
    total = float(np.sum(het[ok]*k[ok]/(k[ok] - 1)))
    return total/(end - start - masked_columns)


def read_mask_intervals(mask_file, chrom, start, end):
    intervals = []
    found = False
    with open(mask_file) as f:
        for line in f:
            fields = line.split()
            if len(fields) < 3 or fields[0] != chrom:
                continue
            found = True
            lo, hi = max(int(fields[1]) + 1, int(start) + 1), min(int(fields[2]), int(end))
            if lo <= hi:
                intervals.append((lo, hi))
    if not found:
        sys.exit(f"Error: the -mask_n file {mask_file} has no row for chromosome {chrom}.")
    intervals.sort()
    merged = []
    for lo, hi in intervals:
        if merged and lo <= merged[-1][1] + 1:
            merged[-1] = (merged[-1][0], max(merged[-1][1], hi))
        else:
            merged.append((lo, hi))
    return merged


def read_masks(mask_n, mask_p, chrom_n, chrom_p, start, end):
    intervals = read_mask_intervals(mask_n, chrom_n, start, end) if mask_n else []
    if mask_p:
        kept = []
        found = False
        with open(mask_p) as f:
            for line in f:
                fields = line.split()
                if len(fields) < 3 or fields[0] != chrom_p:
                    continue
                found = True
                lo, hi = max(int(fields[1]) + 1, int(start) + 1), min(int(fields[2]), int(end))
                if lo <= hi:
                    kept.append((lo, hi))
        if not found:
            sys.exit(f"Error: the -mask_p file {mask_p} has no row for chromosome {chrom_p}.")
        kept.sort()
        next_lo = int(start) + 1
        for lo, hi in kept:
            if lo > next_lo:
                intervals.append((next_lo, lo - 1))
            next_lo = max(next_lo, hi + 1)
        if next_lo <= int(end):
            intervals.append((next_lo, int(end)))
    intervals.sort()
    merged = []
    for lo, hi in intervals:
        if merged and lo <= merged[-1][1] + 1:
            merged[-1] = (merged[-1][0], max(merged[-1][1], hi))
        else:
            merged.append((lo, hi))
    return merged


def calculate_diversity(vcf_prefix, start, end, mask_n=None, mask_p=None, chrom=None, chrom_n=None, chrom_p=None):
    total_diversity = 0.0
    segment_length = end - start
    num_variants = 0
    masked = []

    # Open the VCF file and read it line by line
    with vcf_io.open_vcf(vcf_prefix, chrom or vcf_io.first_chrom(vcf_prefix)) as vcf:
        for line in vcf:
            # Skip header lines
            if line.startswith("#"):
                continue

            # Split the VCF record into fields
            fields = line.strip().split('\t')
            pos = int(fields[1])  # Get the position of the variant
            
            # Check if the variant is within the target region
            if (mask_n or mask_p) and not masked:
                masked = read_masks(mask_n, mask_p, chrom_n or fields[0], chrom_p or fields[0], start, end)
                segment_length -= sum(hi - lo + 1 for lo, hi in masked)
            if pos < start:
                continue
            if pos >= end:
                break
            if any(lo <= pos <= hi for lo, hi in masked):
                continue
            
            # Extract genotype information for each sample (after the 9th column)
            alleles = [fields[3]] + fields[4].split(",")  # REF and ALT alleles
            allele_counts = [0] * len(alleles)
            num_samples = 0

            # Iterate over the genotype columns to count allele occurrences
            for sample_field in fields[9:]:
                gt = sample_field.split(':')[0]  # Extract the genotype (e.g., "0/1")
                if '.' in gt:  # Missing data
                    continue
                
                # Genotype fields are usually formatted like "0/1", "1/1", etc.
                gt_alleles = gt.replace('|', '/').split('/')  # Handle phased/unphased
                num_samples += 1
                for allele in gt_alleles:
                    allele_counts[int(allele)] += 1

            k = sum(allele_counts)
            if k < 2:
                continue
            allele_freqs = [ac / k for ac in allele_counts]

            variant_diversity = sum(f * (1 - f) for f in allele_freqs if f > 0 and f < 1) * k / (k - 1)
            
            # Add to total diversity
            total_diversity += variant_diversity
            num_variants += 1

    nucleotide_diversity = total_diversity / segment_length
    return nucleotide_diversity

def read_tip_ages(tip_ages_file, vcf_prefix, ploidy):
    names = read_alignment(vcf_prefix)[0] if is_alignment(vcf_prefix) else vcf_io.sample_names(vcf_prefix)
    n = ploidy*len(names)
    rows = []
    ncol = None
    with open(tip_ages_file) as f:
        for lineno, line in enumerate(f, 1):
            parts = line.split()
            if not parts or parts[0].startswith('#'):
                continue
            if ncol is None:
                ncol = len(parts)
            if len(parts) != ncol or ncol > 2:
                raise ValueError(f"tip_ages line {lineno}: expected 1 column (ages in VCF sample order) or 2 columns (name age)")
            rows.append((parts[0] if ncol == 2 else None, float(parts[-1])))
    if len(rows) != len(names):
        raise ValueError(f"tip_ages has {len(rows)} rows for {len(names)} samples in the VCF")
    if ncol == 1:
        return [rows[i//ploidy][1] for i in range(n)]
    by_name = {}
    for name, age in rows:
        if name in by_name:
            raise ValueError(f"tip_ages: duplicate name {name!r}")
        by_name[name] = age
    ages = []
    for i in range(n):
        if names[i//ploidy] not in by_name:
            raise ValueError(f"tip_ages has no row for {names[i//ploidy]!r}")
        ages.append(by_name[names[i//ploidy]])
    return ages

def compute_Ne(vcf_prefix, start, end, m, ploidy, ages=None, g=None, mask_n=None, mask_p=None, chrom=None, chrom_n=None, chrom_p=None, four_state=False):
    alignment = is_alignment(vcf_prefix)
    if alignment:
        seqs = read_alignment(vcf_prefix)[1]
        diversity = calculate_diversity_alignment(seqs, start, end, mask_n, mask_p, chrom_n, chrom_p)
    else:
        diversity = calculate_diversity(vcf_prefix, start, end, mask_n, mask_p, chrom, chrom_n, chrom_p)
    if four_state:
        B = 0.75
        if alignment:
            counts = np.zeros(4)
            for s in seqs:
                for b, c in enumerate('ACGT'):
                    counts[b] += s[int(start):int(end)].upper().count(c)
            if counts.sum() > 0:
                B = 1 - np.sum((counts/counts.sum())**2)
        if diversity >= B:
            sys.exit("Error: the diversity is saturated; give -Ne.")
        diversity = -B*np.log(1 - diversity/B)
    mean_abs_diff = 0.0
    if ages:
        gens = [a/g for a in ages]
        n = len(gens)
        pairs = [abs(gens[i] - gens[j]) for i in range(n) for j in range(i + 1, n)]
        mean_abs_diff = sum(pairs)/len(pairs)
    Ne = diversity/(2*ploidy)/m - mean_abs_diff/(2*ploidy)
    if Ne <= 0:
        raise ValueError(f"Estimated Ne is non-positive ({Ne:.1f}). Check that tip ages and mutation rate are in consistent units.")
    print(f"Estimated Ne: {Ne:.1f}")
    return Ne

def tip_flags(tip_ages, g):
    if tip_ages is None:
        return ""
    return f" -tip_ages {tip_ages} -g {g}"

def singer_path():
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "singer")

def is_number(value):
    try:
        float(value)
    except ValueError:
        return False
    return True

def run_singer(Ne, m, r, start, end, vcf_prefix, output_prefix, num_iters, thin, polar, ploidy, seed, tips, resume, scaling=""):
    cmd = f"{singer_path()} -Ne {Ne} -m {m} -r {r} -input {vcf_prefix} -output {output_prefix} -start {start} -end {end}" + (f" -polar {polar}" if polar is not None else "") + f" -n {num_iters} -thin {thin}" + (" -resume" if resume else "") + f" -ploidy {ploidy}" + tips + scaling + f" -seed {seed}"
    print(cmd)
    sys.exit(subprocess.run(cmd.split(), check=False).returncode)

      
def main():
    parser = argparse.ArgumentParser(description='Sample and infer ARG from genetic variation data')

    parser.add_argument('-Ne', type=float, default=-1, help='Effective population size. Default: estimated from the diversity.')
    parser.add_argument('-m', type=str, required=True, help='Mutation rate: a number, or a rate map file.')
    parser.add_argument('-r', type=str, help='Recombination rate: a number, or a rate map file. Default: the -m value.')
    parser.add_argument('-input', type=str, help='Input file: .vcf, .vcf.gz, .bcf, or an alignment (FASTA, PHYLIP, NEXUS).')
    parser.add_argument('-subst_model', type=str, default='CFN', choices=['CFN', 'JC', 'K80', 'F81', 'HKY', 'GTR'], help='Substitution model: CFN, JC, K80, F81, HKY or GTR. Default: CFN.')
    parser.add_argument('-gamma', type=int, default=1, help='Number of discrete gamma rate categories under a four-state model. Default: 1.')
    parser.add_argument('-augment', action='store_true', help='Sample the mutations with the ARG under a four-state model.')
    parser.add_argument('-output', type=str, required=True, help='Output file prefix.')
    parser.add_argument('-start', type=float, required=True, help='Start position.')
    parser.add_argument('-end', type=float, required=True, help='End position (exclusive).')
    parser.add_argument('-n', type=int, default=100, help='Number of MCMC samples. Default: 100.')
    parser.add_argument('-thin', type=int, default=200, help='Thinning interval length. Default: 200.')
    parser.add_argument('-polar', type=float, help='Probability of correct polarization. Default: 0.5.')
    parser.add_argument('-resume', action='store_true', help='Resume MCMC with this flag.')
    parser.add_argument('-ploidy', type=int, help="Ploidy of the vcf file (1 or 2). Default: 2, or 1 for an alignment.")
    parser.add_argument('-seed', type=int, default=42, help='Random seed for reproducibility. Default: 42.')
    parser.add_argument('-tip_ages', type=str, help='File with the sample ages in years before present. Requires -g.')
    parser.add_argument('-g', type=float, help='Generation time in years.')
    parser.add_argument('-mask_n', type=str, help='Negative mask: a BED file of the regions to mask.')
    parser.add_argument('-mask_p', type=str, help='Positive mask: a BED file of the accessible regions.')
    parser.add_argument('-chrom', type=str, help='Chromosome to read from the VCF. Default: the first one.')
    parser.add_argument('-chrom_n', type=str, help='Chromosome of the -mask_n file. Default: -chrom.')
    parser.add_argument('-chrom_p', type=str, help='Chromosome of the -mask_p file. Default: -chrom.')
    parser.add_argument('-scaling_rep', type=int, help='Number of ARG rescaling rounds per sample; 0 disables. Default: 1.')
    parser.add_argument('-scaling_bin', type=int, help='Number of time bins for ARG rescaling. Default: 100.')
    parser.add_argument('-mapping_rep', type=int, help='Number of stochastic mapping draws per sample. Default: 1.')

    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        sys.exit(1)

    args = parser.parse_args()

    if args.r is None:
        if not is_number(args.m):
            parser.error("You must provide -r when -m is a rate map file")
        args.r = args.m

    if args.tip_ages and not args.g:
        parser.error("You must provide -g with -tip_ages")
    alignment = is_alignment(args.input)
    four_state = args.subst_model != 'CFN'
    if alignment and not four_state:
        parser.error("An alignment input needs a four-state model")
    if args.gamma < 1:
        parser.error("-gamma must be at least 1")
    if args.gamma > 1 and not four_state:
        parser.error("-gamma needs a four-state model")
    if args.augment and not four_state:
        parser.error("-augment needs a four-state model")
    if args.polar is not None and four_state:
        parser.error("-polar applies to CFN only")
    if alignment and args.chrom:
        parser.error("-chrom applies to VCF input only")
    if args.ploidy is None:
        args.ploidy = 1 if alignment else 2
    polar = (0.5 if args.polar is None else args.polar) if not four_state else None
    tips = tip_flags(args.tip_ages, args.g)
    tips += f" -subst_model {args.subst_model}"
    if args.gamma > 1:
        tips += f" -gamma {args.gamma}"
    if args.augment:
        tips += " -augment"
    if args.mask_n:
        tips += f" -mask_n {args.mask_n}"
    if args.mask_p:
        tips += f" -mask_p {args.mask_p}"
    if args.chrom:
        tips += f" -chrom {args.chrom}"
    if args.chrom_n:
        tips += f" -chrom_n {args.chrom_n}"
    if args.chrom_p:
        tips += f" -chrom_p {args.chrom_p}"
    ages = read_tip_ages(args.tip_ages, args.input, args.ploidy) if args.tip_ages else None

    m = float(args.m) if is_number(args.m) else compute_average_rate(args.m, args.start, args.end)
    if m == 0:
        parser.error("The mutation rate is set to 0")
    if args.Ne < 0:
        args.Ne = compute_Ne(args.input, args.start, args.end, m, args.ploidy, ages, args.g, args.mask_n, args.mask_p, args.chrom, args.chrom_n, args.chrom_p, four_state)
    scaling = (f" -scaling_rep {args.scaling_rep}" if args.scaling_rep is not None else "") + (f" -scaling_bin {args.scaling_bin}" if args.scaling_bin is not None else "") + (f" -mapping_rep {args.mapping_rep}" if args.mapping_rep is not None else "")
    run_singer(args.Ne, args.m, args.r, args.start, args.end, args.input, args.output, args.n, args.thin, polar, args.ploidy, args.seed, tips, args.resume, scaling)


if __name__ == "__main__":
    main()
